"""
USDT TRC-20 Outgoing Wallet Screener — Last 30 Days
Shows energy consumed, TRX burned, and TRX saved via energy.

Requirements:
    pip3 install requests pandas tabulate
"""

import time
import requests
import pandas as pd
from tabulate import tabulate
from datetime import datetime, timezone, timedelta

# ── Config ────────────────────────────────────────────────────────────────────
WALLET            = "TP5k2KsstiSB9UqRu5QMsbXuMPRcTtgeMf"
USDT_CONTRACT     = "TR7NHqjeKQxGTCi8q8ZY4pL8otSzgjLj6t"
TRONGRID_API_KEY  = "ed75d57a-0ef0-462c-a068-98ccfee36883"
TRONSCAN_BASE     = "https://apilist.tronscanapi.com/api"
MAX_TX            = 2000
DELAY             = 0.25
EXPORT_CSV        = True

# TRX price per energy unit when burning TRX (1 energy = 0.00042 TRX at 420 sun/energy)
# Actual dynamic rate from network — used to estimate TRX saved
ENERGY_UNIT_PRICE_SUN = 420  # sun per energy unit (current network rate)

HEADERS = {
    "User-Agent":       "Mozilla/5.0",
    "Accept":           "application/json",
    "TRON-PRO-API-KEY": TRONGRID_API_KEY,
}

# ── Date range: last 30 days ──────────────────────────────────────────────────
NOW        = datetime.now(timezone.utc)
MONTH_AGO  = NOW - timedelta(days=30)
TS_START   = int(MONTH_AGO.timestamp() * 1000)  # milliseconds
TS_END     = int(NOW.timestamp() * 1000)

# ── Helpers ───────────────────────────────────────────────────────────────────
def get(url, params=None):
    r = requests.get(url, params=params, headers=HEADERS, timeout=15)
    r.raise_for_status()
    return r.json()

# ── Step 1: Fetch outgoing USDT transfers in last 30 days ─────────────────────
def fetch_outgoing(wallet):
    txs, start, limit = [], 0, 50
    total = None
    print(f"\n📡 Fetching OUTGOING USDT transfers for {wallet}")
    print(f"   Period: {MONTH_AGO.strftime('%Y-%m-%d')} → {NOW.strftime('%Y-%m-%d')}\n")

    while True:
        params = {
            "limit":            limit,
            "start":            start,
            "relatedAddress":   wallet,
            "contract_address": USDT_CONTRACT,
            "start_timestamp":  TS_START,
            "end_timestamp":    TS_END,
            "db_version":       1,
        }
        data  = get(f"{TRONSCAN_BASE}/token_trc20/transfers", params)
        items = data.get("token_transfers") or data.get("data") or []

        if total is None:
            total = data.get("total") or data.get("rangeTotal") or len(items)

        for t in items:
            from_addr = t.get("from_address") or t.get("transferFromAddress", "")
            # Only keep outgoing (sent FROM our wallet)
            if from_addr.lower() != wallet.lower():
                continue
            txs.append({
                "tx_hash":   t.get("transaction_id") or t.get("transactionHash", ""),
                "timestamp": t.get("block_ts") or t.get("blockTimestamp") or 0,
                "to_addr":   t.get("to_address") or t.get("transferToAddress", ""),
                "usdt":      int(t.get("quant") or t.get("amount") or t.get("value") or 0) / 1e6,
            })

        fetched = start + len(items)
        print(f"  … scanned {fetched} / {total} total, {len(txs)} outgoing so far", end="\r")
        start += limit
        if fetched >= total or len(items) < limit or fetched >= MAX_TX:
            break
        time.sleep(DELAY)

    print(f"\n  ✅ {len(txs)} outgoing transfers found.\n")
    return txs

# ── Step 2: Fetch energy & fee details per tx ─────────────────────────────────
def fetch_tx_detail(tx_hash):
    try:
        data = get(f"{TRONSCAN_BASE}/transaction-info", {"hash": tx_hash})
        cost = data.get("cost") or {}

        energy_usage   = cost.get("energy_usage", 0)        # energy from own stake
        energy_fee     = cost.get("energy_fee", 0)           # sun paid for energy (burned TRX)
        energy_total   = cost.get("energy_usage_total", 0)   # total energy consumed
        net_fee        = cost.get("net_fee", 0)              # bandwidth fee in sun
        net_usage      = cost.get("net_usage", 0)            # bandwidth from stake
        total_fee_sun  = cost.get("fee", 0)                  # total TRX burned in sun

        # If energy_usage_total not provided, sum it up
        if not energy_total:
            energy_total = energy_usage + int(energy_fee / ENERGY_UNIT_PRICE_SUN)

        # TRX burned = fees actually paid in TRX
        trx_burned = total_fee_sun / 1e6 if total_fee_sun else (energy_fee + net_fee) / 1e6

        # TRX saved = energy covered by staked TRX (not burned)
        # = energy_usage (from stake) * price per energy unit
        trx_saved = (energy_usage * ENERGY_UNIT_PRICE_SUN) / 1e6

        return {
            "energy_total":  energy_total,   # total energy consumed
            "energy_staked": energy_usage,   # energy from own/delegated stake
            "energy_burned": int(energy_fee / ENERGY_UNIT_PRICE_SUN) if ENERGY_UNIT_PRICE_SUN else 0,
            "net_usage":     net_usage,
            "trx_burned":    trx_burned,
            "trx_saved":     trx_saved,
        }
    except Exception as e:
        return {"energy_total":0,"energy_staked":0,"energy_burned":0,"net_usage":0,"trx_burned":0,"trx_saved":0}

def enrich(txs):
    print(f"⛽ Fetching energy & fee details for {len(txs)} transactions …")
    for i, tx in enumerate(txs, 1):
        detail = fetch_tx_detail(tx["tx_hash"])
        tx.update(detail)
        if i % 5 == 0 or i == len(txs):
            print(f"  … {i} / {len(txs)}", end="\r")
        time.sleep(DELAY)
    print(f"\n  ✅ Done.\n")
    return txs

# ── Step 3: Report ─────────────────────────────────────────────────────────────
def report(txs, wallet):
    df = pd.DataFrame(txs)
    df["datetime"] = pd.to_datetime(df["timestamp"], unit="ms", utc=True)

    total_usdt         = df["usdt"].sum()
    total_energy       = df["energy_total"].sum()
    energy_from_stake  = df["energy_staked"].sum()
    energy_from_burn   = df["energy_burned"].sum()
    total_trx_burned   = df["trx_burned"].sum()
    total_trx_saved    = df["trx_saved"].sum()
    avg_energy_per_tx  = df["energy_total"].mean()
    avg_trx_burned     = df["trx_burned"].mean()

    print("═"*65)
    print(f"  Wallet  : {wallet}")
    print(f"  Period  : {MONTH_AGO.strftime('%Y-%m-%d')} → {NOW.strftime('%Y-%m-%d')}")
    print("═"*65)

    summary = [
        ["Outgoing transactions",         len(df)],
        ["Total USDT sent",               f"{total_usdt:,.2f} USDT"],
        ["─"*30,                          "─"*20],
        ["Total energy consumed",         f"{int(total_energy):,} units"],
        ["  ↳ From staked TRX",           f"{int(energy_from_stake):,} units"],
        ["  ↳ Paid by burning TRX",       f"{int(energy_from_burn):,} units"],
        ["Avg energy per transaction",    f"{int(avg_energy_per_tx):,} units"],
        ["─"*30,                          "─"*20],
        ["Total TRX burned (fees paid)",  f"{total_trx_burned:.4f} TRX"],
        ["Total TRX saved (via stake)",   f"{total_trx_saved:.4f} TRX"],
        ["Avg TRX burned per tx",         f"{avg_trx_burned:.4f} TRX"],
        ["─"*30,                          "─"*20],
        ["Net cost if NO energy stake",   f"{total_trx_burned + total_trx_saved:.4f} TRX"],
        ["You saved",                     f"{total_trx_saved:.4f} TRX ({total_trx_saved/(total_trx_burned+total_trx_saved)*100:.1f}% discount)" if (total_trx_burned+total_trx_saved) > 0 else "N/A"],
    ]
    print(tabulate(summary, tablefmt="simple"))
    print("═"*65)

    # Last 20 transactions
    cols = ["datetime","usdt","energy_total","energy_staked","trx_burned","trx_saved","to_addr"]
    heads = ["Date (UTC)","USDT","Energy","From Stake","TRX Burned","TRX Saved","To Address"]
    print(f"\n  Last {min(20,len(df))} outgoing transactions:\n")
    display = df[cols].tail(20).copy()
    display["to_addr"] = display["to_addr"].apply(lambda a: a[:10]+"..."+a[-5:] if a else "")
    print(tabulate(display.values, headers=heads, tablefmt="simple", floatfmt=".4f"))

    return df

# ── Step 4: Export ────────────────────────────────────────────────────────────
def export(df, wallet):
    fname = f"outgoing_usdt_{wallet[:10]}_{MONTH_AGO.strftime('%Y%m%d')}.csv"
    df[[
        "tx_hash","datetime","to_addr","usdt",
        "energy_total","energy_staked","energy_burned",
        "trx_burned","trx_saved"
    ]].to_csv(fname, index=False)
    print(f"\n  💾 Exported to {fname}")

# ── Main ──────────────────────────────────────────────────────────────────────
if __name__ == "__main__":
    txs = fetch_outgoing(WALLET)
    if not txs:
        print("⚠️  No outgoing USDT transactions found in the last 30 days.")
    else:
        txs = enrich(txs)
        df  = report(txs, WALLET)
        if EXPORT_CSV:
            export(df, WALLET)
    print("\n✅ Done.\n")
